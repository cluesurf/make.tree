
form result
  case okay
    link value
  case error
    link reason

task result-map
  take r, like result
  take f
  fork case, read r
    hook okay, base value
      send back, make okay
        bind value, call f
          bind x, read value
    hook error, base reason
      send back, make error
        bind reason, read reason

task result-unwrap
  take r, like result
  take fallback
  fork case, read r
    hook okay, base value
      send back, read value
    hook error, base reason
      send back, read fallback

task result-is-okay
  take r, like result
  fork case, read r
    hook okay, base value
      send back, wave true
    hook error, base reason
      send back, wave false

task result-is-error
  take r, like result
  fork case, read r
    hook okay, base value
      send back, wave false
    hook error, base reason
      send back, wave true
