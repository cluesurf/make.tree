
form report
  link passed, like size
  link failed, like size
  link skipped, like size
  link duration, like size

form failure
  link name, like text
  link message, like text

form mock
  link count, like size

task make
  take passed, like size
  take failed, like size
  take skipped, like size
  take duration, like size
  send back
    make report
      bind passed, read passed
      bind failed, read failed
      bind skipped, read skipped
      bind duration, read duration

task passed
  take r, like report
  fork case, read r
    hook report, base passed, base failed, base skipped, base duration
      send back, read passed

task total
  take r, like report
  fork case, read r
    hook report, base passed, base failed, base skipped, base duration
      send back
        call add
          bind a
            call add
              bind a, read passed
              bind b, read failed
          bind b, read skipped

task fail
  take name, like text
  take message, like text
  send back
    make failure
      bind name, read name
      bind message, read message

task name
  take f, like failure
  fork case, read f
    hook failure, base name, base message
      send back, read name

task stamp
  send back
    make mock
      bind count, mark 0

task count
  take m, like mock
  fork case, read m
    hook mock, base count
      send back, read count
