
task classify
  take n, like u64
  fork roll
    hook is-negative
      call lt
        bind a, read n
        bind b, mark 0
      send back, text <negative>
    hook is-zero
      call eq
        bind a, read n
        bind b, mark 0
      send back, text <zero>
    hook is-positive
      send back, text <positive>
