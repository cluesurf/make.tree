
form pair
  case pair
    link fst
    link snd

task make-pair
  take a
  take b
  back make pair
    bind fst, read a
    bind snd, read b

task pair-fst
  take p, like pair
  fork case, read p
    hook pair, base fst, base snd
      back read fst

task pair-snd
  take p, like pair
  fork case, read p
    hook pair, base fst, base snd
      back read snd

task pair-swap
  take p, like pair
  fork case, read p
    hook pair, base fst, base snd
      back make pair
        bind fst, read snd
        bind snd, read fst

task pair-map-fst
  take p, like pair
  take f
  fork case, read p
    hook pair, base fst, base snd
      back make pair
        bind fst, call f
          bind x, read fst
        bind snd, read snd

task pair-map-snd
  take p, like pair
  take f
  fork case, read p
    hook pair, base fst, base snd
      back make pair
        bind fst, read fst
        bind snd, call f
          bind x, read snd
