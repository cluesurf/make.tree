form nat
  case zero
  case succ
    link pred

task fib
  take n, like nat
  fork case, read n
    hook zero
      send back, mark 0
    hook succ, base pred
      fork case, read pred
        hook zero
          send back, mark 1
        hook succ, base pp
          save a
            call fib
              bind n, read pred
          save b
            call fib
              bind n, read pp
          send back, call add
            bind a, read a
            bind b, read b

task make-zero
  send back, make zero

task make-succ
  take p, like nat
  send back, make succ
    bind pred, read p

task fib-tail
  take n, like nat
  take a, like u64
  take b, like u64
  fork case, read n
    hook zero
      send back, read a
    hook succ, base pred
      send back, call fib-tail
        bind n, read pred
        bind a, read b
        bind b, call add
          bind a, read a
          bind b, read b

task double
  take n, like u64
  send back, call mul
    bind a, read n
    bind b, mark 2
