
form server
  link dock, hide true
  link host, like text
  link port, like size

form request
  link method, like text
  link url, like text
  link path, like text
  link query, like text
  link headers, like hash
  link dock, hide true

form response
  link status, like size
  link headers, like hash
  link body, like text
  link dock, hide true

form router
  link dock, hide true

task start
  wait true
  take port, like size
  take host, like text, fall text <0.0.0.0>
  take handler, like task
  take secure, like bool, fall wave false
  like server

  save raw
    call http-create-server
      read handler

  call raw/listen
    wait true
    read port
    read host

  send back
    make server
      bind dock, read raw
      bind host, read host
      bind port, read port

task stop
  wait true
  take server, like server

  save raw, read server/dock
  call raw/close
    wait true

task read-request
  wait true
  take request, like request
  take format, like text, fall text <text>

  save raw, read request/dock

  fork case, read format
    case text
      send back
        call raw/text
          wait true
    case bytes
      send back
        call raw/bytes
          wait true
    case json
      send back
        call raw/json
          wait true

task make-response
  take status, like size, fall 200
  take headers, like hash, need false
  take body, like text, need false
  like response

  send back
    make response
      bind status, read status
      bind headers
        fork test
          hook test
            call is-some, read headers
          hook hold
            read headers
          hook miss
            make find
      bind body
        fork test
          hook test
            call is-some, read body
          hook hold
            read body
          hook miss
            text <>
      bind dock, wave true

task make-router
  like router

  send back
    make router
      bind dock
        make find
          save routes, make list

task add-route
  take router, like router
  take method, like text
  take pattern, like text
  take handler, like task
  like router

  call router/dock/routes/push
    make find
      save method, read method
      save pattern, read pattern
      save handler, read handler

  send back, read router

task handle-routes
  take router, like router
  like task

  send back
    task dispatch
      wait true
      take request, like request

      save routes, read router/dock/routes

      walk list, read routes
        hook next
          take site, name route
          fork test
            hook test
              call and
                call is-equal
                  read route/method
                  read request/method
                call match-path
                  read route/pattern
                  read request/path
            hook hold
              send back
                call route/handler
                  wait true
                  read request

      send back
        make response
          bind status, mark 404
          bind headers, make find
          bind body, text <Not Found>
          bind dock, wave true
