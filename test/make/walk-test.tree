
task count-to
  take n, like u64
  save total, mark 0
  save i, mark 0
  walk test
    call lt
      bind a, read i
      bind b, read n
    hook step
      save total
        call add
          bind a, read total
          bind b, read i
      save i
        call add
          bind a, read i
          bind b, mark 1
  back read total

task factorial
  take n, like u64
  save result, mark 1
  save i, mark 1
  walk test
    call lte
      bind a, read i
      bind b, read n
    hook step
      save result
        call mul
          bind a, read result
          bind b, read i
      save i
        call add
          bind a, read i
          bind b, mark 1
  back read result

task count-down
  take n, like u64
  save i, read n
  walk test
    call gt
      bind a, read i
      bind b, mark 0
    hook step
      save i
        call sub
          bind a, read i
          bind b, mark 1
  back read i
