load ./nat
  find form nat

task fib
  take n, like nat
  fork case, read n
    hook zero
      back mark 0
    hook succ, base pred
      fork case, read pred
        hook zero
          back mark 1
        hook succ, base pp
          save a
            call fib
              bind n, read pred
          save b
            call fib
              bind n, read pp
          back call add
            bind a, read a
            bind b, read b

task fib-tail
  take n, like nat
  take a, like u64
  take b, like u64
  fork case, read n
    hook zero
      back read a
    hook succ, base pred
      back call fib-tail
        bind n, read pred
        bind a, read b
        bind b, call add
          bind a, read a
          bind b, read b

task double
  take n, like u64
  back call mul
    bind a, read n
    bind b, mark 2
