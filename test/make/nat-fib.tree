
form bool
  case true
  case false

form nat
  case zero
  case succ
    link pred

task nat-is-zero
  take n, like nat
  fork case, read n
    hook zero
      send back, make true
    hook succ, base pred
      send back, make false

task make-zero
  send back, make zero

task make-succ
  take p, like nat
  send back, make succ
    bind pred, read p

task nat-add
  take a, like nat
  take b, like nat
  fork case, read a
    hook zero
      send back, read b
    hook succ, base pred
      send back, make succ
        bind pred, call nat-add
          bind a, read pred
          bind b, read b

task nat-fib
  take n, like nat
  fork case, read n
    hook zero
      send back, make zero
    hook succ, base pred
      fork case, read pred
        hook zero
          send back, make succ
            bind pred, make zero
        hook succ, base pp
          send back, call nat-add
            bind a, call nat-fib
              bind n, read pred
            bind b, call nat-fib
              bind n, read pp
