
form bool
  case true
  case false

form nat
  case zero
  case succ
    link pred

task nat-is-zero
  take n, like nat
  fork case, loan n
    hook zero
      back make true
    hook succ, base pred
      back make false

task make-zero
  back make zero

task make-succ
  take p, like nat
  back make succ
    bind pred, loan p

task nat-add
  take a, like nat
  take b, like nat
  fork case, loan a
    hook zero
      back loan b
    hook succ, base pred
      back make succ
        bind pred, call nat-add
          bind a, loan pred
          bind b, loan b

task nat-fib
  take n, like nat
  fork case, loan n
    hook zero
      back make zero
    hook succ, base pred
      fork case, loan pred
        hook zero
          back make succ
            bind pred, make zero
        hook succ, base pp
          back call nat-add
            bind a, call nat-fib
              bind n, loan pred
            bind b, call nat-fib
              bind n, loan pp
