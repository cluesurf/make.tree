
dock load
  load <std:fs>, name fs

task write-file
  take path, like text
  take content, like text
  save r
    call fs/write
      bind path, loan path
      bind content, loan content
  call r/unwrap
  back text <done>

task read-file
  take path, like text
  save r
    call fs/read-to-string
      bind path, loan path
  back call r/unwrap
