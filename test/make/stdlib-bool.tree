
form bool
  case true
  case false

task bool-not
  take a, like bool
  fork case, read a
    hook true
      send back, make false
    hook false
      send back, make true

task bool-and
  take a, like bool
  take b, like bool
  fork case, read a
    hook true
      send back, read b
    hook false
      send back, make false

task bool-or
  take a, like bool
  take b, like bool
  fork case, read a
    hook true
      send back, make true
    hook false
      send back, read b

task bool-xor
  take a, like bool
  take b, like bool
  fork case, read a
    hook true
      send back, call bool-not
        bind a, read b
    hook false
      send back, read b

task bool-eq
  take a, like bool
  take b, like bool
  fork case, read a
    hook true
      send back, read b
    hook false
      send back, call bool-not
        bind a, read b
