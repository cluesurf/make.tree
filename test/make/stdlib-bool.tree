
form bool
  case true
  case false

task bool-not
  take a, like bool
  fork case, read a
    hook true
      back make false
    hook false
      back make true

task bool-and
  take a, like bool
  take b, like bool
  fork case, read a
    hook true
      back read b
    hook false
      back make false

task bool-or
  take a, like bool
  take b, like bool
  fork case, read a
    hook true
      back make true
    hook false
      back read b

task bool-xor
  take a, like bool
  take b, like bool
  fork case, read a
    hook true
      back call bool-not
        bind a, read b
    hook false
      back read b

task bool-eq
  take a, like bool
  take b, like bool
  fork case, read a
    hook true
      back read b
    hook false
      back call bool-not
        bind a, read b
