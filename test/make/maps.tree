task make-map
  save m
    make find
      bind foo, text <bar>
      bind key, mark 42
  send back, read m

task map-ops
  save m
    make find
  call m/save
    bind k, text <hello>
    bind v, mark 1
  send back, call m/read
    bind k, text <hello>

task get-size
  take m
  send back, call m/size
