
form order
  case less
  case equal
  case more

task order-reverse
  take o, like order
  fork case, read o
    hook less
      send back, make more
    hook equal
      send back, make equal
    hook more
      send back, make less

task order-is-less
  take o, like order
  fork case, read o
    hook less
      send back, wave true
    hook equal
      send back, wave false
    hook more
      send back, wave false

task order-is-equal
  take o, like order
  fork case, read o
    hook less
      send back, wave false
    hook equal
      send back, wave true
    hook more
      send back, wave false

task order-is-more
  take o, like order
  fork case, read o
    hook less
      send back, wave false
    hook equal
      send back, wave false
    hook more
      send back, wave true

task compare-u64
  take a, like u64
  take b, like u64
  save is-less
    call lt
      bind a, read a
      bind b, read b
  fork case, read is-less
    hook true
      send back, make less
    hook false
      save is-eq
        call eq
          bind a, read a
          bind b, read b
      fork case, read is-eq
        hook true
          send back, make equal
        hook false
          send back, make more
