
form maybe
  case some
    link value
  case none

task maybe-map
  take m, like maybe
  take f
  fork case, read m
    hook some, base value
      send back, make some
        bind value, call f
          bind x, read value
    hook none
      send back, make none

task maybe-unwrap
  take m, like maybe
  take fallback
  fork case, read m
    hook some, base value
      send back, read value
    hook none
      send back, read fallback

task maybe-is-some
  take m, like maybe
  fork case, read m
    hook some, base value
      send back, wave true
    hook none
      send back, wave false

task maybe-is-none
  take m, like maybe
  fork case, read m
    hook some, base value
      send back, wave false
    hook none
      send back, wave true

task maybe-from-wave
  take cond, like bool
  take value
  fork case, read cond
    hook true
      send back, make some
        bind value, read value
    hook false
      send back, make none
