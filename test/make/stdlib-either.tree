
form either
  case left
    link value
  case right
    link value

task either-map-right
  take e, like either
  take f
  fork case, read e
    hook left, base value
      back make left
        bind value, read value
    hook right, base value
      back make right
        bind value, call f
          bind x, read value

task either-map-left
  take e, like either
  take f
  fork case, read e
    hook left, base value
      back make left
        bind value, call f
          bind x, read value
    hook right, base value
      back make right
        bind value, read value

task either-unwrap-right
  take e, like either
  take fallback
  fork case, read e
    hook left, base value
      back read fallback
    hook right, base value
      back read value

task either-unwrap-left
  take e, like either
  take fallback
  fork case, read e
    hook left, base value
      back read value
    hook right, base value
      back read fallback

task either-is-left
  take e, like either
  fork case, read e
    hook left, base value
      back wave true
    hook right, base value
      back wave false

task either-is-right
  take e, like either
  fork case, read e
    hook left, base value
      back wave false
    hook right, base value
      back wave true
