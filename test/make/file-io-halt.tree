
dock load
  load <std:fs>, name fs

task write-file
  take path, like text
  take content, like text
  call fs/write
    bind path, read path
    bind content, read content
    halt kink
  back text <done>

task read-file
  take path, like text
  back
    call fs/read-to-string
      bind path, read path
      halt kink
