
task max
  take a, like u64
  take b, like u64
  fork test
    call gt
      bind a, read a
      bind b, read b
    hook true
      send back, read a
    hook false
      send back, read b

task is-zero
  take n, like u64
  fork test
    call eq
      bind a, read n
      bind b, mark 0
    hook true
      send back, mark 1
    hook false
      send back, mark 0

task clamp
  take n, like u64
  take lo, like u64
  take hi, like u64
  fork test
    call lt
      bind a, read n
      bind b, read lo
    hook true
      send back, read lo
    hook false
      fork test
        call gt
          bind a, read n
          bind b, read hi
        hook true
          send back, read hi
        hook false
          send back, read n
