
task max
  take a, like u64
  take b, like u64
  fork test
    call gt
      bind a, read a
      bind b, read b
    hook true
      back read a
    hook false
      back read b

task is-zero
  take n, like u64
  fork test
    call eq
      bind a, read n
      bind b, mark 0
    hook true
      back mark 1
    hook false
      back mark 0

task clamp
  take n, like u64
  take lo, like u64
  take hi, like u64
  fork test
    call lt
      bind a, read n
      bind b, read lo
    hook true
      back read lo
    hook false
      fork test
        call gt
          bind a, read n
          bind b, read hi
        hook true
          back read hi
        hook false
          back read n
